ont-size:16px}}  .db-fc-input.db-fc-input-password-field{padding:0 35px 0 15px}  .db-fc-input-disabled{height:40px;background:#e6e7e880;border:1px solid rgba(50,58,69,.2);border-radius:6px;font-size:14px;padding:0 16px;display:flex;align-items:center;box-sizing:border-box;width:100%;line-height:19px;font-family:Open Sans,sans-serif;color:#00000080;-webkit-appearance:none;cursor:default}  .db-fc-input-disabled:focus{outline:0}  .db-fc-input_invalid{color:#dd2925;border-color:#f2aba9}  .db-fc-input_invalid:focus{border-color:#f2aba9;box-shadow:0 2px 4px 2px #f2aba933}  .db-fc-checkbox{display:inline-block;box-sizing:border-box;padding:1px;width:16px;height:16px;line-height:0;cursor:pointer;border-radius:1px;background-color:#fff;border:1px solid #D0D0D0;vertical-align:middle}  .db-fc-checkbox input{display:none}  .db-fc-checkbox span{display:inline-block;font-size:0}  .db-fc-checkbox span i{font-size:0}  .db-fc-checkbox input:checked+span i{font-size:16px;color:#2160b5}  .db-fc-checkbox input:checked+span i.db-icon-check{position:relative;font-size:13px;color:#2160b5!important}  .db-fc-checkbox.black{display:flex;align-items:center;justify-content:flex-start;flex-direction:row;border:none}  .db-fc-checkbox.black .ds-check-icon-wrap{display:inline-flex;align-items:center;justify-content:center;flex-direction:row;box-sizing:border-box;padding:1px;width:16px;height:16px;min-width:16px;min-height:16px;line-height:0;border-radius:2px;border:1px solid #EAEAEA;flex-shrink:0}  .db-fc-checkbox.black input:not(:checked)+span:hover{border:1px solid black}  .db-fc-checkbox.black input:checked+span{background:#000;border:none}  .db-fc-checkbox.black input:checked+span i.db-icon-ds-checkmark{font-size:14px;color:#fff!important;position:relative}  .db-fc-radio-checkbox{display:inline-block;box-sizing:border-box;width:16px;height:16px;line-height:16px;cursor:pointer;border-radius:50%;background-color:#fff;border:solid .5px rgba(0,0,0,.15)}  .db-fc-radio-checkbox input{display:none}  