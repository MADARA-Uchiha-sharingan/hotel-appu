der-radius:50%;background:#fff}  .db-fc-radio input:checked~span{background-color:#29b311}  .db-fc-radio input:checked~span:after{display:block}  .db-fc-switch{cursor:pointer}  .db-fc-switch .db-switch{display:inline-block;font-size:0;line-height:0}  .db-fc-switch .db-switch__bg{display:inline-block;position:relative;background-color:#f4f4f4;border:1px solid rgba(0,0,0,.15);font-size:0;line-height:0;vertical-align:middle;transition:background-color 75ms ease-in-out;width:40px;height:24px;border-radius:20px;box-sizing:border-box}  .db-fc-switch .db-switch__head{display:inline-block;position:absolute;top:-1px;left:0;width:22px;height:22px;background-color:#fff;transition:left 75ms ease-in-out;border-radius:20px;border:solid 1px rgba(0,0,0,.15)}  .db-fc-switch .db-switch__input{display:none}  .db-fc-switch .db-switch__input:checked+.db-switch__bg{background-color:#85d431;border-color:#85d431}  .db-fc-switch .db-switch__input:checked+.db-switch__bg .db-switch__head{left:15px;border-color:#85d431}  .db-fc-switch .db-switch__label{display:inline-block;margin-right:10px;font-size:14px;font-weight:200;line-height:16px;vertical-align:middle}  .db-bg-stroke{opacity:.1;stroke:#0cce6b;fill:#0cce6b;color:#0cce6b;stroke-width:8}  .db-bg-stroke.db-stroke-yellow{stroke:#ffa400;fill:#ffa400;color:#ffa400}  .db-bg-stroke.db-stroke-red{stroke:#ff4e42;fill:#ff4e42;color:#ff4e42}  .db-score-stroke{stroke:#0cce6b;fill:none;color:#0cce6b;stroke-width:8;stroke-linecap:round}  .db-score-stroke.db-score-stroke-yellow{stroke:#ffa400;color:#ffa400}  .db-score-stroke.db-score-stroke-red{stroke:#ff4e42;color:#ff4e42}  .db-button{display:inline-block;box-sizing:border-box;min-width:150px;border-radius:15px;border:0;font-weight:300;text-align:center;vertical-align:middle;cursor:pointer;transition:background-color .15s linear,color .15s linear}  .db-button,   .db-button:active,   .db-button:focus{background-color:#f4f4f4;color:#323a45}  .db-button:hover{background-color:#eeecec;color:#323a45}  .db-